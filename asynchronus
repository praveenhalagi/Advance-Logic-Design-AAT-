module JK_flipflop (
    input clk,
    input rst_n,
    input j, k,
    output reg q,
    output q_bar
);

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n)
            q <= 1'b0;
        else begin
            case ({j, k})
                2'b00: q <= q;
                2'b01: q <= 1'b0;
                2'b10: q <= 1'b1;
                2'b11: q <= ~q;
            endcase
        end
    end

    assign q_bar = ~q;

endmodule


module updown_selector (
    input q,
    input q_bar,
    input up,
    output nclk
);

    assign nclk = up ? q_bar : q;

endmodule


module asynchronous_counter #(
    parameter SIZE = 4
)(
    input clk,
    input rst_n,
    input up,
    output [SIZE-1:0] q,
    output [SIZE-1:0] q_bar
);

    wire [SIZE-2:0] nclk;
    genvar g;

    JK_flipflop jk0(
        clk, rst_n, 1'b1, 1'b1, q[0], q_bar[0]
    );

    generate
        for (g = 1; g < SIZE; g = g + 1) begin : counter_stages
            updown_selector ud(
                q[g-1], q_bar[g-1], up, nclk[g-1]
            );

            JK_flipflop jk(
                nclk[g-1], rst_n, 1'b1, 1'b1,
                q[g], q_bar[g]
            );
        end
    endgenerate

endmodule


module tb;

    reg clk, rst_n, up;
    wire [3:0] q, q_bar;

    asynchronous_counter dut(clk, rst_n, up, q, q_bar);
    initial begin
    $dumpfile("dump.vcd");
      $dumpvars(0, tb);
end


    always #5 clk = ~clk;

    initial begin
